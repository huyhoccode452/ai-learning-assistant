GEMINI_API_KEY=
GEMINI_LLM_MODEL=
GEMINI_EMBEDDING_MODEL=
EMBEDDING_DIM=
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documents
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
SCORE_THRESHOLD=
MAX_UPLOAD_MB=20
SQLITE_PATH=data/app.sqlite3
EMBED_MAX_RETRIES=5
LLM_THINKING_LEVEL=
UPLOAD_DIR=data/uploads

# ---------------------------------------------------------------- public demo / deployment
# An empty value means "not set" (the default below applies).

# Qdrant Cloud: set QDRANT_URL (above) to the cluster URL, e.g. https://<cluster-id>.<region>.cloud.qdrant.io:6333,
# and put the cluster's API key here. Leave empty for a local Qdrant (docker compose up -d).
# Changing the embedding model/dimension needs a new collection: use another QDRANT_COLLECTION or delete the old one.
QDRANT_API_KEY=

# DEMO_MODE=true: public-demo limits. MAX_UPLOAD_MB becomes the smaller of itself and DEMO_MAX_UPLOAD_MB, and the
# whole instance (there are no accounts) holds at most DEMO_MAX_DOCUMENTS documents; uploads beyond that are refused
# until someone deletes one. Re-uploading a file that is already indexed is never refused.
DEMO_MODE=false
DEMO_MAX_UPLOAD_MB=5
DEMO_MAX_DOCUMENTS=10

# Max requests per client IP per UTC day to the endpoints that call Gemini: chat, summary, quiz, upload.
# 0 = no limit (local use). Set it (for example 30) on a public demo. Counters live in memory: a restart resets them.
DAILY_LIMIT_PER_IP=0

# Reverse proxies in front of the app. 0 = count by the socket address (right for local runs).
# Behind a host such as Render the socket address is the proxy itself, so every visitor would share ONE counter:
# set this to the number of proxies so the real client IP is read from X-Forwarded-For (taken from the right,
# where the forged part of the header cannot reach). Check your host's docs: too high falls back to the socket
# address, too low counts a proxy's address instead of the visitor's.
TRUSTED_PROXY_HOPS=0

# Used by `python -m app.main` (the Docker image runs it). Hosts such as Render set PORT themselves.
# HOST defaults to 127.0.0.1 outside Docker; the Dockerfile sets 0.0.0.0.
# PORT=8000
# HOST=127.0.0.1
